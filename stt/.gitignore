# STT service — local files

# Third-party native binaries and the sherpa-onnx Java jar are downloaded, not committed.
# See README.md ("Build & run") for the exact files and where they come from:
#   lib/libsherpa-onnx-jni.so, lib/libonnxruntime.so, lib/sherpa-onnx-jvm.jar
lib/

# Models are several hundred MB each and are installed at runtime through
# /api/models/download (or copied in by hand). Never commit them.
models/
sherpa-onnx-whisper-*/

# Compiled output (the service runs straight from .class files here)
*.class

# Runtime logs and crash dumps
*.log
hs_err_pid*.log

# Local rollback copies
*.bak
*.bak-*
