# Build output
target/
*.class

# The sherpa-onnx JVM bindings and the native libraries. Downloaded, not committed.
# See scripts/install-stt-jar.sh and the README.
lib/

# The native archives themselves, unpacked by setup.bat / the README.
sherpa-onnx-v*-jni/
sherpa-onnx-v*-jni.tar.bz2
win-jni.tar.bz2

# Whisper models are several hundred MB each and are installed at runtime
# through /api/models/download (or copied in by hand). Never commit them.
models/
sherpa-onnx-whisper-*/

# Runtime / editor / OS noise
app.log
app.pid
*.log
hs_err_pid*.log
.idea/
*.iml
.vscode/
.DS_Store

# Local rollback copies (kept on disk, never published)
*.bak
*.bak-*
*.orig
*.rej

# Local secrets — never commit (use environment variables)
.env
.env.*
*.pem
*.key
application-local.yml

# ...except the throw-away test CA, which is a public certificate with no key.
!cert/vpn-test-root.pem
