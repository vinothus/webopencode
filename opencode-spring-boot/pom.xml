<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.pawwork.opencode</groupId>
  <artifactId>opencode-spring-boot-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <name>OpenCode Spring Boot Parent</name>
  <description>Spring Boot library that talks to AI models through the OpenCode gateway (OpenAI-compatible wire), plus an OpenAPI-exposed demo app.</description>

  <modules>
    <module>opencode-spring-boot-starter</module>
    <module>opencode-demo-app</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <springdoc.version>2.8.17</springdoc.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.pawwork.opencode</groupId>
        <artifactId>opencode-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
